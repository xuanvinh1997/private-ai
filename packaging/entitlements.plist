<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Dictation. Without this the hardened runtime denies the microphone even when the
       user has granted permission in System Settings. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- CPython writes and executes memory for its own bytecode caches, and several of the
       numeric wheels do the same. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- PyInstaller lays hundreds of .so files inside the bundle. Under the hardened runtime
       each would have to carry the same team signature as the executable; they do not,
       because they came from wheels built by other people. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Ollama and any MCP server the user configures are reached over the network. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
