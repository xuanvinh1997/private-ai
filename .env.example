# Mọi biến ở đây tương ứng với đúng một trường trong src/private_ai/config.py.
# Ứng dụng, tiến trình worker và mọi MCP server đều đọc cùng một object Settings,
# nên đặt một lần là có tác dụng ở khắp nơi. Copy file này thành .env để dùng.

# --- chung ------------------------------------------------------------------
PRIVATE_AI_APP_NAME=Private AI
# Toàn bộ dữ liệu cục bộ: SQLite, tài liệu đã tải lên, chỉ mục LightRAG, model ASR.
PRIVATE_AI_DATA_DIR=.local-data

# --- nhà cung cấp mô hình ----------------------------------------------------
# Chỉ dùng để seed bản ghi Ollama cục bộ ở lần chạy đầu; sau đó sửa trong Cài đặt.
PRIVATE_AI_OLLAMA_URL=http://127.0.0.1:11434
# Đặt false để tắt hẳn embedding: không tạo vector, không dựng knowledge graph.
PRIVATE_AI_EMBEDDING_ENABLED=true
PRIVATE_AI_EMBEDDING_MODEL=embeddinggemma
# Model đọc ảnh cho OCR. Để trống thì worker tự tìm model có capability vision.
PRIVATE_AI_VISION_MODEL=
PRIVATE_AI_REQUEST_TIMEOUT_SECONDS=60
# Sinh chữ không giống các request khác: liệt kê model thì nên hỏng nhanh, còn một mô
# hình 27B chạy cục bộ trả lời từ tài liệu dài có thể mất vài phút, và bản tóm tắt
# map-reduce tốn một lượt gọi cho mỗi lô. 60 giây cắt ngang các lượt đó.
PRIVATE_AI_GENERATION_TIMEOUT_SECONDS=600

# --- trợ lý (LangGraph) ------------------------------------------------------
# Ngân sách đệ quy của graph. Một lần gọi công cụ kèm lượt đọc kết quả tốn hai bước,
# nên 10 tương đương khoảng bốn vòng công cụ cộng một lượt trả lời.
PRIVATE_AI_AGENT_MAX_ITERATIONS=10
PRIVATE_AI_AGENT_STREAM_TOKENS=true
PRIVATE_AI_SKILLS_ENABLED=true
# Thư mục chứa các gói SKILL.md bổ sung, ngoài gói dựng sẵn và <data_dir>/skills.
# Ngăn cách bằng : (Windows dùng ;).
PRIVATE_AI_SKILL_PATHS=

# --- truy hồi ----------------------------------------------------------------
# auto | vector | keyword | hybrid | graph | summary | web
PRIVATE_AI_RETRIEVAL_DEFAULT_STRATEGY=auto
PRIVATE_AI_RETRIEVAL_TOP_K=5
# Trần cứng cho lượng văn bản truy hồi được đưa vào system prompt, tính bằng ký tự.
# Khoảng 4 ký tự một token, nên 24000 tương đương ~6k token ngữ cảnh. Đây là thứ chặn
# một chiến lược đọc toàn văn (summary) làm tràn cửa sổ ngữ cảnh.
PRIVATE_AI_RETRIEVAL_CONTEXT_CHARS=24000
# 1400 được chọn theo model embedding đang dùng; đổi số này là đổi ý nghĩa của
# mọi vector đã lưu, nên chỉ đổi khi định tạo lại chỉ mục.
PRIVATE_AI_RETRIEVAL_CHUNK_SIZE=1400
PRIVATE_AI_RETRIEVAL_CHUNK_OVERLAP=180
PRIVATE_AI_EMBEDDING_BATCH_SIZE=32
PRIVATE_AI_EMBEDDING_CONCURRENCY=4

# --- MCP ---------------------------------------------------------------------
# Chỉ dùng khi chạy MCP server qua Streamable HTTP cho client bên ngoài; trong ứng
# dụng bảy server nội bộ được mount thẳng trong tiến trình, không đi qua mạng.
PRIVATE_AI_MCP_HOST=127.0.0.1
PRIVATE_AI_MCP_PORT=8010
PRIVATE_AI_MCP_REQUIRE_AUTH=true
# MCP server bên ngoài cho bản cài không có UI, dạng JSON:
# {"ten":{"command":"uvx","args":["gói"]}} hoặc {"ten":{"url":"http://..."}}
PRIVATE_AI_MCP_EXTERNAL_SERVERS=

# --- nhận dạng giọng nói -----------------------------------------------------
PRIVATE_AI_ASR_ENABLED=true
# Hai biến dưới nhận Path hoặc bỏ trống hẳn. Để "=" với giá trị rỗng sẽ thành Path("."),
# nên hãy giữ chúng ở dạng comment và để `private-ai-asr setup` dựng bản trong
# <data_dir>/asr, hoặc bỏ comment và trỏ tới đường dẫn thật.
# PRIVATE_AI_ASR_EXECUTABLE=/duong/dan/toi/transcribe
# PRIVATE_AI_ASR_MODEL=/duong/dan/toi/model.gguf
PRIVATE_AI_ASR_LANGUAGE=vi-VN
PRIVATE_AI_FFMPEG_EXECUTABLE=

# --- GPU ---------------------------------------------------------------------
# Không đặt thì tự nhận diện theo máy: trên Apple Silicon lấy iogpu.wired_limit_mb hoặc
# phần RAM macOS dành cho GPU, nền tảng khác mặc định 96 GiB. Chỉ bỏ comment khi muốn ép
# một hạn mức khác — giá trị rỗng sẽ làm Settings không đọc được.
# PRIVATE_AI_GPU_CAPACITY_BYTES=103079215104
PRIVATE_AI_GPU_MODEL_OVERHEAD_RATIO=1.1
PRIVATE_AI_ASR_VRAM_RESERVATION_BYTES=2147483648

# --- tệp và tải lên ----------------------------------------------------------
PRIVATE_AI_WEB_SEARCH_TIMEOUT_SECONDS=20
# Thư mục file tool được đọc sẵn, ngăn cách bằng : (Windows dùng ;).
# Để trống thì mọi đường dẫn đều phải được người dùng duyệt lúc tool hỏi.
PRIVATE_AI_FILE_ROOTS=
PRIVATE_AI_FILE_READ_MAX_BYTES=1048576
PRIVATE_AI_MAX_UPLOAD_BYTES=104857600

# --- đọc tài liệu ------------------------------------------------------------
# Ứng dụng desktop để false và sinh tiến trình private-ai-worker, vì parse và chunk
# là Python thuần giữ GIL suốt thời gian xử lý một tệp. Script headless không có
# tiến trình thứ hai thì bật true.
PRIVATE_AI_INLINE_INGESTION=false
PRIVATE_AI_WORKER_POLL_SECONDS=2

# --- giao diện ---------------------------------------------------------------
# light | dark | system
PRIVATE_AI_UI_THEME=light
# compact | normal | large
PRIVATE_AI_UI_FONT_SCALE=normal
PRIVATE_AI_UI_LANGUAGE=vi

# --- hạ tầng RAG Rust --------------------------------------------------------
# Tạo một chuỗi ngẫu nhiên dài trước khi chạy `docker compose up -d`.
QDRANT_API_KEY=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_MEM_LIMIT=16g
