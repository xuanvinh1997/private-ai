{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Private AI",
  "version": "0.1.0",
  "identifier": "com.privateai.harness",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node ../scripts/prepare-sidecars.mjs && npm run dev --prefix ../ui",
    "beforeBuildCommand": "npm run build --prefix ../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Private AI",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../skills/**/*"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Coding agent chạy trên máy bạn",
    "longDescription": "Trợ lý lập trình chạy hoàn toàn trên máy người dùng: đọc và sửa mã nguồn trong thư mục làm việc, chạy lệnh trong vòng giam, và không gửi gì ra ngoài ngoài lời gọi tới máy chủ mô hình mà người dùng chỉ định.",
    "copyright": "© 2026",
    "publisher": "Private AI",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Vietnamese",
          "English"
        ]
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
